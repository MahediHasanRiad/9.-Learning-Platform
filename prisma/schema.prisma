generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  mobile         String
  password       String
  address        String?
  avatar         String
  coverImage     String?
  bio            String?
  facebook       String?
  linkedIn       String?
  teacher        Teacher?
  coachingCenter CoachingCenter?
  subjects       Subject[]
  coachingStaffs CoachingStaff[]
  demoClasses    DemoClass[]
  batches        Batch[]
  enrollments    Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id            String  @id @default(cuid())
  user          User    @relation(fields: [userId], references: [id])
  userId        String  @unique
  education     String
  certificate   String?
  experience    String? @default("0 years of experience")
  availableDay  String? @default("00-00-2000")
  availableTime String? @default("00:00am - 00:00am")
  rating        Int?    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoachingCenter {
  id             String          @id @default(cuid())
  CcName         String
  email          String?
  address        String?
  mobile         String?
  avatar         String?
  coverImage     String?
  website        String?
  officeTime     String?
  bio            String?
  facebook       String?
  linkedIn       String?
  user           User            @relation(fields: [userId], references: [id])
  userId         String          @unique
  status         String?
  coachingStaffs CoachingStaff[]
  batches        Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id          String      @id @default(cuid())
  name        String
  className   String
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  demoClasses DemoClass[]
  batches     Batch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoachingStaff {
  id         String         @id @default(cuid())
  user       User           @relation(fields: [staffId], references: [id])
  staffId    String
  coaching   CoachingCenter @relation(fields: [coachingId], references: [id])
  coachingId String
  role       String         @default("Teacher")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DemoClass {
  id        String  @id @default(cuid())
  title     String
  videoURL  String
  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId String
  batch     Batch?   @relation(fields: [batchId], references: [id])
  batchId   String?
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  status    String  @default("Draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id               String         @id @default(cuid())
  name             String
  coverImage       String?
  subjects         Subject[]
  start_date       String
  end_date         String
  capacity         Int
  price            Int
  assignedTeachers User[]
  recurringRule    String[]
  coaching         CoachingCenter @relation(fields: [coachingId], references: [id])
  coachingId       String
  bio              String?
  demoClasses      DemoClass[]
  enrollments      Enrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id        String @id @default(cuid())
  student   User   @relation(fields: [studentId], references: [id])
  studentId String
  batch     Batch  @relation(fields: [batchId], references: [id])
  batchId   String
  status    String @default("Pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
